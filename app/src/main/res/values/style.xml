<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="TransparentBottomSheetDialog" parent="Theme.Material3.Light.BottomSheetDialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="NoBottomStroke" parent="Theme.Material3.Light.Dialog">
        <item name="strokeColor">@android:color/transparent</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearanceOverlay">@style/TopRounded</item>
    </style>

    <style name="TopRounded" parent="Theme.Material3.Light.Dialog">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">10dp</item>
        <item name="cornerSizeTopRight">10dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Theme.MyApp.Dialog" parent="Theme.Material3.Light.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

</resources>